# Collie agent image: the toolbox every isolated project runs in. Built by
# `collie --build-image` (or from the UI) on top of the base image
# (base/Containerfile, usually pulled from GHCR); rebuild to update the
# agents.
ARG BASE
FROM ${BASE}

# The agents and the Playwright MCP server (with Chromium). AGENTS_REV is
# bumped by "rebuild" to pull the latest versions without a full rebuild.
ARG AGENTS_REV=0
RUN echo "agents rev ${AGENTS_REV}" \
    && npm install -g --no-audit --no-fund @anthropic-ai/claude-code @openai/codex @playwright/mcp \
    && pw="$(npm root -g)/@playwright/mcp/node_modules/playwright/cli.js" \
    && { [ -f "$pw" ] || pw="$(npm root -g)/playwright/cli.js"; } \
    && node "$pw" install --with-deps chromium \
    && chmod -R a+rX /opt/ms-playwright \
    && npm cache clean --force && rm -rf /var/lib/apt/lists/* /root/.cache

COPY collie-exec collie-kill /usr/local/bin/
RUN chmod 755 /usr/local/bin/collie-exec /usr/local/bin/collie-kill \
    && mkdir -p /home/agent && chmod 777 /home/agent

# No setuid or setgid programs (su, passwd, mount …): agents have no use
# for them, and no-new-privileges, which makes them powerless, is off in
# projects with containers inside. Last, after everything that installs
# packages. newuidmap/newgidmap work through file capabilities instead
# (base/Containerfile), which this keeps.
RUN find / -xdev -type f -perm /6000 -exec chmod ug-s {} +

# Toolchains a project installs with mise (`mise install` from its
# mise.toml or .tool-versions) work by name: mise's shims are on PATH. They
# come last, so what the image has (node, python) stays the image's: Codex
# and the Playwright MCP server run on that node, and a project's own
# version of those is `mise exec -- node`. (MISE_YES, set in the base, also
# answers mise's trust prompt, so a project's config needs no `mise trust`
# here.)
ENV HOME=/home/agent \
    PATH=$PATH:/home/agent/.local/share/mise/shims
WORKDIR /home/agent
CMD ["sleep", "infinity"]
