#!/bin/bash
# collie-exec <id> <command...>
# Runs the command in its own session and records the session id so that
# `collie-kill <id>` can stop it together with everything it spawned
# (signals sent to the `podman exec` client are not forwarded).
id="$1"; shift
mkdir -p /tmp/collie-pg
# `podman exec -t` already makes us a session leader with the terminal as
# controlling tty. A new session would lose it (and it can't be taken back
# without CAP_SYS_ADMIN), leaving an interactive shell without job control,
# so keep this session then.
if [ -t 0 ] && [ "$(ps -o sid= -p $$ | tr -d ' ')" = "$$" ]; then
  echo $$ > "/tmp/collie-pg/$id"
  exec "$@"
fi
exec setsid --wait bash -c 'echo $$ > "/tmp/collie-pg/$0"; exec "$@"' "$id" "$@"
